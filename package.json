{
  "name": "template-docs-expert",
  "version": "1.0.0",
  "description": "A research assistant that answers questions with web-sourced citations using a Mastra web search tool routed through Mastra's Gateway. Stores observability and observational memory in Turso (libSQL).",
  "main": "index.js",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc",
    "compare": "node --import tsx --env-file=.env scripts/compare-web.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "@mastra/editor": "latest",
    "@mastra/libsql": "latest",
    "@mastra/loggers": "latest",
    "@mastra/mcp": "^2.11.0",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "dotenv": "^17.3.1",
    "mastra": "latest",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
